{
  "realm": "aifya",
  "enabled": true,
  "displayName": "Aifya HMIS",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "failureFactor": 5,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 7200,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "system_admin",
        "description": "System administrator"
      },
      {
        "name": "hospital_admin",
        "description": "Hospital administrator"
      },
      {
        "name": "facility_admin",
        "description": "Facility administrator"
      },
      {
        "name": "doctor",
        "description": "Medical doctor / clinical officer"
      },
      {
        "name": "nurse",
        "description": "Registered nurse / enrolled nurse"
      },
      {
        "name": "registration",
        "description": "Patient Registration"
      },
      {
        "name": "records",
        "description": "Health records clerk"
      },
      {
        "name": "cashier",
