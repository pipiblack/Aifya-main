      },
      {
        "name": "pathologist",
        "description": "Pathologist"
      },
      {
        "name": "pharmacist",
        "description": "Pharmacist"
      },
      {
        "name": "radiologist",
        "description": "Radiologist"
      },
      {
        "name": "store_keeper",
        "description": "Store Keeper"
      },
      {
        "name": "midwife",
        "description": "MCH / Midwife"
      },
      {
        "name": "hr_manager",
        "description": "HR Manager"
      },
      {
        "name": "claims_officer",
        "description": "Claims Officer"
      },
      {
        "name": "investigator",
        "description": "Clinical trials investigator"
      },
      {
        "name": "research_coordinator",
        "description": "Clinical trials coordinator"
      }
    ]
  },
  "clients": [
    {
      "clientId": "aifya-web",
      "name": "Aifya Web Application",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "https://*.aifya.health/*",
        "https://*.aifyahealth.co.ke/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "https://*.aifya.health",
        "https://*.aifyahealth.co.ke"
      ],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "aifya-scope"
      ]
    },
    {
      "clientId": "aifya-api",
      "name": "Aifya API Gateway",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "aifya-scope"
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "aifya-scope",
      "description": "Aifya custom claims (facility_id)",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "facility_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "facility_id",
            "claim.name": "facility_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
