# Aifya Knowledge RAG Service — Environment Variables

APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8025

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://aifya_user:change_me_in_production@localhost:5432/aifya

# Keycloak Auth
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=aifya

# Qdrant Vector Store
QDRANT_ENDPOINT=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=aifya_knowledge

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_KNOWLEDGE_BUCKET=aifya-knowledge
MINIO_SECURE=false

# vLLM Generation
VLLM_BASE_URL=http://localhost:8002/v1
GENERATION_MODEL=Qwen/Qwen2.5-72B-Instruct
GENERATION_MAX_TOKENS=2048
GENERATION_TEMPERATURE=0.1

# RAG Settings
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=8
RERANK_TOP_K=4
SIMILARITY_THRESHOLD=0.45

# Celery
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/4

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Upload Limits
MAX_FILE_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
