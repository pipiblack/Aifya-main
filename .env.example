# =============================================================================
# Aifya Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aifya
POSTGRES_USER=aifya_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- MinIO (Object Storage) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aifya-documents

# --- Keycloak (Auth) ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=aifya
KEYCLOAK_CLIENT_ID=aifya-web
KEYCLOAK_CLIENT_SECRET=change_me

# --- AI Services (vLLM) ---
VLLM_DEEPSEEK_R1_URL=http://localhost:8001/v1
VLLM_QWEN_72B_URL=http://localhost:8002/v1
VLLM_DISTILL_32B_URL=http://localhost:8003/v1

# --- Whisper (ScribeAI) ---
WHISPER_URL=http://localhost:8004

# --- Qdrant (Vector DB) ---
QDRANT_URL=http://localhost:6333

# --- External Integrations ---
SHA_API_URL=https://claims.sha.go.ke/api/v1
SHA_API_KEY=
DHIS2_URL=
DHIS2_USERNAME=
DHIS2_PASSWORD=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
KRA_ETIMS_URL=

# --- REDCap ---
REDCAP_API_URL=
# Tokens stored in Vault, not here

# --- App Config ---
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_KNOWLEDGE_API_URL=http://localhost:8025/api/v1
NEXT_PUBLIC_SCRIBE_API_URL=http://localhost:8004
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=aifya
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=aifya-web
SECRET_KEY=change_me_use_openssl_rand_hex_32
FACILITY_TIMEZONE=Africa/Nairobi
