{
  "name": "aifya",
  "version": "0.1.0",
  "private": true,
  "description": "Aifya — AI-Native Hospital Management System",
  "scripts": {
    "dev": "docker compose up -d",
    "dev:web": "pnpm --filter @aifya/web dev",
    "build:web": "pnpm --filter @aifya/web build",
    "test": "pnpm run test:web && pnpm run test:api && pnpm run test:billing",
    "test:web": "pnpm --filter @aifya/web test",
    "test:api": "cd services/api-gateway && python3 -m pytest",
    "test:billing": "cd services/billing-service && go test ./...",
    "lint": "pnpm run lint:web && pnpm run lint:api && pnpm run lint:go",
    "lint:web": "pnpm --filter @aifya/web lint",
    "lint:api": "cd services/api-gateway && ruff check .",
    "lint:go": "cd services/billing-service && golangci-lint run",
    "typecheck": "pnpm --filter @aifya/web typecheck && cd services/api-gateway && python3 -m mypy app",
    "db:migrate": "cd services/api-gateway && alembic upgrade head",
    "db:revision": "cd services/api-gateway && alembic revision --autogenerate -m"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
